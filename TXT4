4.Python that reads a text file notes.txt and counts the total number of lines starting with the letter 'T' or 't'.
def count_lines():
    t_count = 0
    try:
        with open("notes.txt", "r") as file:
            lines = file.readlines()
            for line in lines:
                if line and line[0] in ("T", "t"):
                    t_count += 1
        print(f"Total lines starting with 'T' or 't': {t_count}")
    except FileNotFoundError:
        print("Error: The file 'notes.txt' does not exist.")


# Main Execution
count_lines()
